# bufka configuration variables. bufka reads the process environment; it
# never loads ./.env on its own. For development, copy this file to .env and
# pass it explicitly: bufka --env-file .env … (or BUFKA_ENV_FILE=.env, or
# direnv with `dotenv` in .envrc). Variables already in the environment take
# precedence over the file. Settings saved in the TUI (in the database) take
# precedence over both; `bufka config` shows where each value comes from.

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── HTTP server ──────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# ── DuckDB ─────────────────────────────────────────────────────────────────
# The DuckDB database holding every saved setting, sample and cached topic.
# Empty: $XDG_DATA_HOME/bufka/bufka.duckdb (~/.local/share/bufka/bufka.duckdb).
# ":memory:" for a throwaway in-memory database. "bufka paths" shows it.
DUCKDB_PATH=
# Starts DuckDB's built-in UI server (CALL start_ui_server()) on the port in
# DUCKDB_UI_ADDR. Off by default. run proxies it at /duckdb-ui/; in the tui a
# setting saved in settings > duckdb ui takes precedence over these.
DUCKDB_UI_ENABLED=false
DUCKDB_UI_ADDR=http://localhost:4213

# ── Kafka connection (SASL) ─────────────────────────────────────────────────
KAFKA_SEEDS=localhost:9092
KAFKA_TLS_ENABLED=false
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP=bufka
# When set, overrides KAFKA_CONSUMER_GROUP with prefix + a random suffix.
KAFKA_CONSUMER_GROUP_PREFIX=
KAFKA_INSTANCE_PREFIX=bufka
KAFKA_CLIENT_COUNT=1
KAFKA_MSG_CHAN_CAP=122880
# Strips the Confluent Schema Registry header (magic byte, schema ID and
# message-index path) from every consumed topic that has no per-topic
# KAFKA__TOPICS__N__CUT_CONFLUENCE_PREFIX override.
KAFKA_CUT_CONFLUENCE_PREFIX=false

# ── Arrow batching ───────────────────────────────────────────────────────
KAFKA_ARROW_BATCH_SIZE=1000
KAFKA_ARROW_FLUSH_INTERVAL=5s

# ── Kafka topics -> protobuf message mapping ────────────────────────────────
# Semicolon-separated .proto roots for `proto list-messages` and
# `kafka sample-messages` schema detection.
PROTO_IMPORT_PATHS=./proto
# Semicolon-separated import-only directories (like protoc -I): used to
# resolve imports, never listed or used for detection. google/protobuf/* and
# google/type/* are built in and need no path.
PROTO_INCLUDE_PATHS=
# Semicolon-separated AsyncAPI spec directories/files (2.x/3.x) that document
# JSON-wire-format topics.
ASYNCAPI_PATHS=

# Indexed, starting at 0. Add as many topics as needed; the loader stops at
# the first fully empty index.
KAFKA__TOPICS__0__TOPIC=my-topic
KAFKA__TOPICS__0__PROTO_FILE=schema/my_message.proto
KAFKA__TOPICS__0__MESSAGE_NAME=my.package.MyMessage
KAFKA__TOPICS__0__IMPORT_PATHS=./schema
KAFKA__TOPICS__0__CUT_CONFLUENCE_PREFIX=false

# KAFKA__TOPICS__1__TOPIC=another-topic
# KAFKA__TOPICS__1__PROTO_FILE=schema/another_message.proto
# KAFKA__TOPICS__1__MESSAGE_NAME=my.package.AnotherMessage
